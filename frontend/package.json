{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n app,convex,neo4j -c blue,magenta,green \"pnpm dev:app\" \"pnpm dev:convex\" \"pnpm dev:neo4j\"",
		"dev:app": "vite dev",
		"dev:app:docker": "vite dev --host 0.0.0.0 --port 5173",
		"dev:convex": "convex dev",
		"dev:neo4j": "docker compose up neo4j",
		"generate:mockdata": "node scripts/generate-observegraph-mockdata.mjs",
		"seed:observegraph": "node scripts/seed-observegraph.mjs",
		"seed:observegraph:local": "node scripts/seed-observegraph.mjs --skip-neo4j",
		"test:mockdata": "node scripts/test-observegraph-mockdata.mjs",
		"codegen:convex": "convex codegen",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"typecheck": "tsc --noEmit",
		"check:push": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run build"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^9.39.4",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24.12.0",
		"concurrently": "^9.2.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"convex": "^1.34.0",
		"cytoscape": "^3.33.1",
		"cytoscape-dagre": "^2.5.0",
		"dagre": "^0.8.5",
		"neverthrow": "^8.2.0",
		"neo4j-driver": "^5.28.2",
		"runed": "^0.37.1",
		"zod": "^4.3.6"
	}
}
