# Shared environment for local development
# Copy to `.env` in the repository root and adjust values as needed.

# Docker / Neo4j
NEO4J_AUTH=neo4j/memoriapassword
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=memoriapassword
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL_SIZE=512M
NEO4J_HEAP_MAX_SIZE=512M

# Backend
ENVIRONMENT=development
MEMORIA_USER_ID=meet
MEMORIA_USER_NAME=Meet Kachhadiya

# Frontend / Convex
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=

# Frontend runtime overrides
OBSERVEGRAPH_USE_MOCK_DATA=false
